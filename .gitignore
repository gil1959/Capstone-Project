# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Environment Variables & Secrets (JANGAN DI-PUSH KE GITHUB)
.env
.env.local
.env.*.local
!.env.example

# Virtual Environments
venv/
.venv/
env/
ENV/

# IDE & System Files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Large Historical Datasets (Melebihi Batas GitHub 100 MB)
data/processed/training_dataset*.parquet
data/processed/weather_*.parquet
data/processed/hotspots_snapped_20*.parquet
data/raw/*
!data/raw/.gitkeep

# Generated Daily GeoJSON (Dibuat otomatis oleh runner di VPS, jangan di-push ke Git)
data/processed/*.geojson

# Logs & Temporary Files
logs/
*.log
